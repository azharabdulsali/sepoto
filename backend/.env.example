# ─── Configuration Environment Sepoto Backend (Template) ─────────────────
# Salin file ini: cp .env.example .env  lalu isi nilai yang sesuai.
PORT=5000
NODE_ENV=development

# ─── 1. PostgreSQL Database Configuration ──────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sepoto_db
DB_USER=postgres
DB_PASSWORD=YOUR_DATABASE_PASSWORD

# Atau jika menggunakan DATABASE_URL langsung (Supabase / Neon Cloud):
# DATABASE_URL=postgresql://user:password@host:5432/sepoto_db

# ─── 2. Cloudflare R2 Cloud Storage Credentials ─────────────────────────
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=sepoto-photos
R2_PUBLIC_DOMAIN=https://pub-xxxx.r2.dev

# ─── 3. JWT Authentication ───────────────────────────────────────────────
# WAJIB: Ganti dengan secret yang kuat (64+ karakter hex)!
# Jangan pernah commit nilai aslinya ke git.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_64_CHAR_HEX_SECRET
JWT_EXPIRES_IN=7d

# ─── 4. Frontend Configuration (CORS) ───────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173
# Untuk production: FRONTEND_ORIGIN=https://yourdomain.com
# Origins tambahan (dipisah koma):
# ADDITIONAL_ORIGINS=https://app.yourdomain.com,https://admin.yourdomain.com
