# ─── Configuration Environment Sepoto Backend (Template) ─────────────────
PORT=5000
NODE_ENV=development

# ─── 1. PostgreSQL Database Configuration ──────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sepoto_db
DB_USER=postgres
DB_PASSWORD=YOUR_DATABASE_PASSWORD

# Atau jika menggunakan DATABASE_URL langsung (Supabase / Neon Cloud):
# DATABASE_URL=postgresql://user:password@host:5432/sepoto_db

# ─── 2. Cloudflare R2 Cloud Storage Credentials ─────────────────────────
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=sepoto-photos
R2_PUBLIC_DOMAIN=https://pub-xxxx.r2.dev

# ─── 3. JWT Authentication ───────────────────────────────────────────────
JWT_SECRET=YOUR_JWT_SECRET_KEY
JWT_EXPIRES_IN=7d
